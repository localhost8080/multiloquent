{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Neumorphism — Viva Magenta Light",
  "settings": {
    "color": {
      "palette": [
        { "color": "#BE3455", "name": "Primary",        "slug": "primary"       },
        { "color": "#8F2840", "name": "Primary Dark",   "slug": "primary-dark"  },
        { "color": "#D57090", "name": "Primary Light",  "slug": "primary-light" },
        { "color": "#38B09D", "name": "Secondary",      "slug": "secondary"     },
        { "color": "#ffaa22", "name": "Accent",         "slug": "accent"        },
        { "color": "#BE3455", "name": "Danger",         "slug": "danger"        },
        { "color": "#F9EEF1", "name": "Base",           "slug": "base"          },
        { "color": "#2A1018", "name": "Contrast",       "slug": "contrast"      },
        { "color": "#8C5568", "name": "Muted",          "slug": "muted"         },
        { "color": "#F9EEF1", "name": "Surface",        "slug": "surface"       },
        { "color": "#F0E0E6", "name": "Surface Alt",    "slug": "surface-alt"   },
        { "color": "#E4CCDA", "name": "Border",         "slug": "border"        },
        { "color": "#ffffff", "name": "Shadow Light",   "slug": "shadow-light"  },
        { "color": "#C0A5AE", "name": "Shadow Dark",    "slug": "shadow-dark"   }
      ],
      "gradients": [
        {
          "gradient": "linear-gradient(135deg, #BE3455 0%, #ffaa22 100%)",
          "name": "Primary to Secondary",
          "slug": "primary-to-secondary"
        },
        {
          "gradient": "linear-gradient(135deg, #BE3455 0%, #D57090 100%)",
          "name": "Primary Fade",
          "slug": "primary-fade"
        },
        {
          "gradient": "linear-gradient(180deg, #F9EEF1 0%, #F0E0E6 100%)",
          "name": "Surface to Base",
          "slug": "surface-to-base"
        },
        {
          "gradient": "linear-gradient(135deg, #2A1018 0%, #BE3455 100%)",
          "name": "Dark to Primary",
          "slug": "dark-to-primary"
        }
      ],
      "duotone": [
        {
          "colors": ["#BE3455", "#F9EEF1"],
          "name": "Primary and Base",
          "slug": "primary-and-white"
        },
        {
          "colors": ["#2A1018", "#D57090"],
          "name": "Contrast and Primary",
          "slug": "contrast-and-primary"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--primary-dark)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--base)",
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/pullquote": { "border": { "color": "transparent" } },
      "core/quote":     { "border": { "color": "transparent" } }
    }
  }
}
