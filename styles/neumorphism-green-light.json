{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Neumorphism — Petronas Light",
  "settings": {
    "color": {
      "palette": [
        { "color": "#38B09D", "name": "Primary",        "slug": "primary"       },
        { "color": "#2C8A7A", "name": "Primary Dark",   "slug": "primary-dark"  },
        { "color": "#72C8BB", "name": "Primary Light",  "slug": "primary-light" },
        { "color": "#0F4C81", "name": "Secondary",      "slug": "secondary"     },
        { "color": "#ffaa22", "name": "Accent",         "slug": "accent"        },
        { "color": "#BE3455", "name": "Danger",         "slug": "danger"        },
        { "color": "#E1F3F0", "name": "Base",           "slug": "base"          },
        { "color": "#1A2E2B", "name": "Contrast",       "slug": "contrast"      },
        { "color": "#5E8A85", "name": "Muted",          "slug": "muted"         },
        { "color": "#E1F3F0", "name": "Surface",        "slug": "surface"       },
        { "color": "#D7EFEB", "name": "Surface Alt",    "slug": "surface-alt"   },
        { "color": "#C9EAE5", "name": "Border",         "slug": "border"        },
        { "color": "#ffffff", "name": "Shadow Light",   "slug": "shadow-light"  },
        { "color": "#92B1A8", "name": "Shadow Dark",    "slug": "shadow-dark"   }
      ],
      "gradients": [
        {
          "gradient": "linear-gradient(135deg, #38B09D 0%, #0F4C81 100%)",
          "name": "Primary to Secondary",
          "slug": "primary-to-secondary"
        },
        {
          "gradient": "linear-gradient(135deg, #38B09D 0%, #72C8BB 100%)",
          "name": "Primary Fade",
          "slug": "primary-fade"
        },
        {
          "gradient": "linear-gradient(180deg, #E1F3F0 0%, #D7EFEB 100%)",
          "name": "Surface to Base",
          "slug": "surface-to-base"
        },
        {
          "gradient": "linear-gradient(135deg, #1A2E2B 0%, #38B09D 100%)",
          "name": "Dark to Primary",
          "slug": "dark-to-primary"
        }
      ],
      "duotone": [
        {
          "colors": ["#38B09D", "#E1F3F0"],
          "name": "Primary and Base",
          "slug": "primary-and-white"
        },
        {
          "colors": ["#1A2E2B", "#72C8BB"],
          "name": "Contrast and Primary",
          "slug": "contrast-and-primary"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--primary-dark)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--base)",
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "blocks": {
      "core/pullquote": { "border": { "color": "transparent" } },
      "core/quote":     { "border": { "color": "transparent" } }
    }
  }
}
