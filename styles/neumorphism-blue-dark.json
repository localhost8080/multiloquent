{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Neumorphism — Classic Blue Dark",
  "settings": {
    "color": {
      "palette": [
        { "color": "#0F4C81", "name": "Primary",        "slug": "primary"       },
        { "color": "#0B3960", "name": "Primary Dark",   "slug": "primary-dark"  },
        { "color": "#5285AD", "name": "Primary Light",  "slug": "primary-light" },
        { "color": "#38B09D", "name": "Secondary",      "slug": "secondary"     },
        { "color": "#ffaa22", "name": "Accent",         "slug": "accent"        },
        { "color": "#BE3455", "name": "Danger",         "slug": "danger"        },
        { "color": "#111E2E", "name": "Base",           "slug": "base"          },
        { "color": "#D5E5F5", "name": "Contrast",       "slug": "contrast"      },
        { "color": "#507090", "name": "Muted",          "slug": "muted"         },
        { "color": "#111E2E", "name": "Surface",        "slug": "surface"       },
        { "color": "#18293E", "name": "Surface Alt",    "slug": "surface-alt"   },
        { "color": "#1F334E", "name": "Border",         "slug": "border"        },
        { "color": "#1C304F", "name": "Shadow Light",   "slug": "shadow-light"  },
        { "color": "#080E18", "name": "Shadow Dark",    "slug": "shadow-dark"   }
      ],
      "gradients": [
        {
          "gradient": "linear-gradient(135deg, #0F4C81 0%, #38B09D 100%)",
          "name": "Primary to Secondary",
          "slug": "primary-to-secondary"
        },
        {
          "gradient": "linear-gradient(135deg, #0B3960 0%, #0F4C81 100%)",
          "name": "Primary Fade",
          "slug": "primary-fade"
        },
        {
          "gradient": "linear-gradient(180deg, #18293E 0%, #111E2E 100%)",
          "name": "Surface to Base",
          "slug": "surface-to-base"
        },
        {
          "gradient": "linear-gradient(135deg, #080E18 0%, #0F4C81 100%)",
          "name": "Dark to Primary",
          "slug": "dark-to-primary"
        }
      ],
      "duotone": [
        {
          "colors": ["#0F4C81", "#111E2E"],
          "name": "Primary and Base",
          "slug": "primary-and-white"
        },
        {
          "colors": ["#080E18", "#5285AD"],
          "name": "Dark and Primary",
          "slug": "contrast-and-primary"
        }
      ]
    }
  },
  "styles": {
    "css": ":root{--shadow-sm:3px 3px 6px var(--wp--preset--color--shadow-dark), -3px -3px 6px var(--wp--preset--color--shadow-light);--shadow-md:6px 6px 12px var(--wp--preset--color--shadow-dark), -6px -6px 12px var(--wp--preset--color--shadow-light);--shadow-lg:10px 10px 20px var(--wp--preset--color--shadow-dark), -10px -10px 20px var(--wp--preset--color--shadow-light);--shadow-inset:inset 4px 4px 8px var(--wp--preset--color--shadow-dark), inset -4px -4px 8px var(--wp--preset--color--shadow-light);--shadow-inset-sm:inset 2px 2px 5px var(--wp--preset--color--shadow-dark), inset -2px -2px 5px var(--wp--preset--color--shadow-light);--card-bg:var(--wp--preset--color--base);--card-radius:1rem;--button-bg:var(--wp--preset--color--base);--button-text:var(--wp--preset--color--primary);--button-bg-hover:var(--wp--preset--color--base);--button-text-hover:var(--wp--preset--color--primary-dark);--button-radius:0.625rem;--button-shadow-active:var(--shadow-inset);--pill-bg:var(--wp--preset--color--base);--pill-text:var(--wp--preset--color--primary);--pill-text-hover:var(--wp--preset--color--primary-dark);--pill-shadow:var(--shadow-sm);--pill-shadow-active:var(--shadow-inset-sm);--input-bg:var(--wp--preset--color--base);--input-border:none;--input-shadow:var(--shadow-inset);--input-radius:0.625rem;}",
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--primary-light)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--base)",
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--primary-light)"
          }
        }
      }
    },
    "blocks": {
      "core/pullquote": { "border": { "color": "transparent" } },
      "core/quote":     { "border": { "color": "transparent" } }
    }
  }
}
