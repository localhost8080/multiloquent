{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,

        "color": {
            "custom": true,
            "customDuotone": false,
            "customGradient": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                { "color": "#0066cc", "name": "Primary",                  "slug": "primary"                  },
                { "color": "#0071e3", "name": "Primary Focus",            "slug": "primary-focus"            },
                { "color": "#2997ff", "name": "Primary On Dark",          "slug": "primary-on-dark"          },
                { "color": "#ffffff", "name": "Canvas",                   "slug": "canvas"                   },
                { "color": "#f5f5f7", "name": "Canvas Parchment",         "slug": "canvas-parchment"         },
                { "color": "#fafafc", "name": "Surface Pearl",            "slug": "surface-pearl"            },
                { "color": "#272729", "name": "Surface Tile 1",           "slug": "surface-tile-1"           },
                { "color": "#2a2a2c", "name": "Surface Tile 2",           "slug": "surface-tile-2"           },
                { "color": "#252527", "name": "Surface Tile 3",           "slug": "surface-tile-3"           },
                { "color": "#000000", "name": "Surface Black",            "slug": "surface-black"            },
                { "color": "#d2d2d7", "name": "Surface Chip Translucent", "slug": "surface-chip-translucent" },
                { "color": "#1d1d1f", "name": "Ink",                      "slug": "ink"                      },
                { "color": "#333333", "name": "Ink Muted 80",             "slug": "ink-muted-80"             },
                { "color": "#7a7a7a", "name": "Ink Muted 48",             "slug": "ink-muted-48"             },
                { "color": "#ffffff", "name": "On Dark",                  "slug": "on-dark"                  },
                { "color": "#cccccc", "name": "Body Muted",               "slug": "body-muted"               },
                { "color": "#f0f0f0", "name": "Divider Soft",             "slug": "divider-soft"             },
                { "color": "#e0e0e0", "name": "Hairline",                 "slug": "hairline"                 }
            ]
        },

        "typography": {
            "customFontSize": true,
            "fluid": false,
            "fontFamilies": [
                {
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
                    "name": "System Sans-Serif",
                    "slug": "system"
                },
                {
                    "fontFamily": "Georgia, 'Times New Roman', serif",
                    "name": "Serif",
                    "slug": "serif"
                },
                {
                    "fontFamily": "'Fira Code', 'Fira Mono', 'Cascadia Code', Consolas, monospace",
                    "name": "Monospace",
                    "slug": "mono"
                }
            ],
            "fontSizes": [
                { "fluid": false, "name": "Micro Legal",  "size": "0.625rem",  "slug": "micro-legal"  },
                { "fluid": false, "name": "Fine Print",   "size": "0.75rem",   "slug": "fine-print"   },
                { "fluid": false, "name": "Caption",      "size": "0.875rem",  "slug": "caption"      },
                { "fluid": false, "name": "Body",         "size": "1.0625rem", "slug": "body"         },
                { "fluid": false, "name": "Tagline",      "size": "1.3125rem", "slug": "tagline"      },
                { "fluid": false, "name": "Lead Airy",    "size": "1.5rem",    "slug": "lead-airy"    },
                { "fluid": false, "name": "Lead",         "size": "1.75rem",   "slug": "lead"         },
                { "fluid": false, "name": "Display MD",   "size": "2.125rem",  "slug": "display-md"   },
                { "fluid": false, "name": "Display LG",   "size": "2.5rem",    "slug": "display-lg"   },
                { "fluid": false, "name": "Hero Display", "size": "3.5rem",    "slug": "hero-display" }
            ]
        },

        "spacing": {
            "customSpacingSize": true,
            "units": ["px", "%", "em", "rem", "vw", "vh"],
            "spacingSizes": [
                { "name": "XXS — 4px",      "size": "0.25rem",   "slug": "xxs"     },
                { "name": "XS — 8px",       "size": "0.5rem",    "slug": "xs"      },
                { "name": "SM — 12px",      "size": "0.75rem",   "slug": "sm"      },
                { "name": "MD — 17px",      "size": "1.0625rem", "slug": "md"      },
                { "name": "LG — 24px",      "size": "1.5rem",    "slug": "lg"      },
                { "name": "XL — 32px",      "size": "2rem",      "slug": "xl"      },
                { "name": "XXL — 48px",     "size": "3rem",      "slug": "xxl"     },
                { "name": "Section — 80px", "size": "5rem",      "slug": "section" }
            ]
        },

        "layout": {
            "contentSize": "980px",
            "wideSize": "1440px"
        },

        "dimensions": {
            "aspectRatios": [
                { "name": "Square",     "ratio": "1",    "slug": "square" },
                { "name": "Standard",   "ratio": "4/3",  "slug": "4-3"    },
                { "name": "Portrait",   "ratio": "3/4",  "slug": "3-4"    },
                { "name": "Classic",    "ratio": "3/2",  "slug": "3-2"    },
                { "name": "Wide",       "ratio": "16/9", "slug": "16-9"   },
                { "name": "Ultra-wide", "ratio": "21/9", "slug": "21-9"   }
            ],
            "minHeight": true
        },

        "position": {
            "sticky": true
        },

        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Product",
                    "shadow": "3px 5px 30px 0px rgba(0,0,0,.22)",
                    "slug": "product"
                }
            ]
        },

        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },

        "blocks": {
            "core/navigation": {
                "typography": {
                    "fontSize": true,
                    "lineHeight": true,
                    "letterSpacing": true
                }
            },
            "core/post-featured-image": {
                "dimensions": { "aspectRatio": true }
            }
        }
    },

    "styles": {
        "color": {
            "background": "var(--wp--preset--color--canvas)",
            "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system)",
            "fontSize": "var(--wp--preset--font-size--body)",
            "fontWeight": "400",
            "lineHeight": "1.47",
            "letterSpacing": "-0.374px"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--lg)"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--system)",
                    "fontWeight": "600",
                    "lineHeight": "1.1"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--hero-display)",
                    "lineHeight": "1.07",
                    "letterSpacing": "-0.28px"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--display-lg)",
                    "lineHeight": "1.1",
                    "letterSpacing": "0"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--display-md)",
                    "lineHeight": "1.47",
                    "letterSpacing": "-0.374px"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--tagline)",
                    "lineHeight": "1.19",
                    "letterSpacing": "0.231px"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--body)",
                    "fontWeight": "600",
                    "lineHeight": "1.24",
                    "letterSpacing": "-0.374px"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--caption)",
                    "fontWeight": "600",
                    "lineHeight": "1.29",
                    "letterSpacing": "-0.224px"
                }
            },
            "link": {
                "color": { "text": "var(--wp--preset--color--primary)" },
                ":hover": { "color": { "text": "var(--wp--preset--color--primary-focus)" } },
                "typography": { "textDecoration": "none" }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--canvas)"
                },
                "border": { "radius": "9999px" },
                "spacing": {
                    "padding": { "top": "11px", "bottom": "11px", "left": "22px", "right": "22px" }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--body)",
                    "fontWeight": "400",
                    "lineHeight": "1.0",
                    "letterSpacing": "0"
                },
                ":hover": {
                    "color": { "background": "var(--wp--preset--color--primary-focus)" }
                }
            }
        },
        "blocks": {
            "core/navigation": {
                "color": {
                    "background": "var(--wp--preset--color--surface-black)",
                    "text": "var(--wp--preset--color--on-dark)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--fine-print)",
                    "fontWeight": "400",
                    "lineHeight": "1.0",
                    "letterSpacing": "-0.12px"
                }
            },
            "core/separator": {
                "color": { "text": "var(--wp--preset--color--hairline)" },
                "border": { "color": "var(--wp--preset--color--hairline)" }
            },
            "core/pullquote": {
                "border": {
                    "color": "var(--wp--preset--color--primary)",
                    "style": "solid",
                    "width": "0 0 0 4px"
                },
                "color": { "text": "var(--wp--preset--color--ink-muted-48)" },
                "typography": { "fontStyle": "italic" }
            },
            "core/code": {
                "color": { "background": "var(--wp--preset--color--surface-pearl)" },
                "border": { "radius": "8px" },
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--lg)",
                        "bottom": "var(--wp--preset--spacing--lg)",
                        "left": "var(--wp--preset--spacing--lg)",
                        "right": "var(--wp--preset--spacing--lg)"
                    }
                },
                "typography": { "fontFamily": "var(--wp--preset--font-family--mono)" }
            },
            "core/quote": {
                "border": {
                    "color": "var(--wp--preset--color--primary)",
                    "style": "solid",
                    "width": "0 0 0 4px"
                },
                "spacing": { "padding": { "left": "var(--wp--preset--spacing--lg)" } },
                "typography": { "fontStyle": "italic" }
            },
            "core/post-title": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--display-lg)",
                    "fontWeight": "600",
                    "lineHeight": "1.1",
                    "letterSpacing": "0"
                }
            },
            "core/post-navigation-link": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--canvas)"
                },
                "spacing": {
                    "padding": {
                        "top": "11px",
                        "bottom": "11px",
                        "left": "22px",
                        "right": "22px"
                    }
                },
                "border": { "radius": "9999px" }
            },
            "core/comments": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--lg)"
                }
            }
        }
    },

    "customTemplates": [
        {
            "name": "page",
            "postTypes": ["page"],
            "title": "Default Page"
        }
    ],

    "templateParts": [
        { "area": "header", "name": "header", "title": "Header" },
        { "area": "footer", "name": "footer", "title": "Footer" }
    ]
}
