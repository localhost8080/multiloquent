{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Forest & Cream",
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,

        "color": {
            "custom": true,
            "customDuotone": true,
            "customGradient": true,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                { "color": "#2E6F40", "name": "Forest Green",      "slug": "primary"       },
                { "color": "#1E482A", "name": "Forest Green Dark", "slug": "primary-dark"  },
                { "color": "#E6EEE8", "name": "Light Green",       "slug": "primary-light" },
                { "color": "#8C6B26", "name": "Gold",              "slug": "secondary"     },
                { "color": "#A35022", "name": "Terracotta",        "slug": "accent"        },
                { "color": "#B3402B", "name": "Danger",            "slug": "danger"        },
                { "color": "#FEFBEA", "name": "Cream",             "slug": "base"          },
                { "color": "#15321D", "name": "Dark Green",        "slug": "contrast"      },
                { "color": "#677865", "name": "Muted Green",       "slug": "muted"         },
                { "color": "#F2F6F4", "name": "Surface",           "slug": "surface"       },
                { "color": "#D5E2D9", "name": "Surface Alt",       "slug": "surface-alt"   },
                { "color": "#DEE8E0", "name": "Border",            "slug": "border"        },
                { "color": "#FFFFFF", "name": "Shadow Light",      "slug": "shadow-light"  },
                { "color": "#15321D", "name": "Shadow Dark",       "slug": "shadow-dark"   }
            ],
            "gradients": [
                {
                    "gradient": "linear-gradient(135deg, #2E6F40 0%, #1E482A 100%)",
                    "name": "Forest Fade",
                    "slug": "primary-to-secondary"
                },
                {
                    "gradient": "linear-gradient(135deg, #2E6F40 0%, #E6EEE8 100%)",
                    "name": "Forest to Light Green",
                    "slug": "primary-fade"
                },
                {
                    "gradient": "linear-gradient(180deg, #FEFBEA 0%, #E6EEE8 100%)",
                    "name": "Cream to Light Green",
                    "slug": "surface-to-base"
                },
                {
                    "gradient": "linear-gradient(135deg, #15321D 0%, #2E6F40 100%)",
                    "name": "Dark Green to Forest",
                    "slug": "dark-to-primary"
                }
            ],
            "duotone": [
                {
                    "colors": ["#2E6F40", "#FEFBEA"],
                    "name": "Forest and Cream",
                    "slug": "primary-and-white"
                },
                {
                    "colors": ["#15321D", "#E6EEE8"],
                    "name": "Dark Green and Light Green",
                    "slug": "contrast-and-primary"
                }
            ]
        },

        "typography": {
            "customFontSize": true,
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
                    "name": "Inter",
                    "slug": "system",
                    "fontFace": [
                        { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400", "src": ["file:./assets/fonts/inter/inter-400.woff2"] },
                        { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "500", "src": ["file:./assets/fonts/inter/inter-500.woff2"] },
                        { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "600", "src": ["file:./assets/fonts/inter/inter-600.woff2"] },
                        { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "700", "src": ["file:./assets/fonts/inter/inter-700.woff2"] }
                    ]
                },
                {
                    "fontFamily": "'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                    "name": "Plus Jakarta Sans",
                    "slug": "heading",
                    "fontFace": [
                        { "fontFamily": "Plus Jakarta Sans", "fontStyle": "normal", "fontWeight": "600", "src": ["file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-600.woff2"] },
                        { "fontFamily": "Plus Jakarta Sans", "fontStyle": "normal", "fontWeight": "700", "src": ["file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-700.woff2"] },
                        { "fontFamily": "Plus Jakarta Sans", "fontStyle": "normal", "fontWeight": "800", "src": ["file:./assets/fonts/plus-jakarta-sans/plus-jakarta-sans-800.woff2"] }
                    ]
                },
                {
                    "fontFamily": "Georgia, 'Times New Roman', serif",
                    "name": "Serif",
                    "slug": "serif"
                },
                {
                    "fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace",
                    "name": "JetBrains Mono",
                    "slug": "mono",
                    "fontFace": [
                        { "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "400", "src": ["file:./assets/fonts/jetbrains-mono/jetbrains-mono-400.woff2"] },
                        { "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "500", "src": ["file:./assets/fonts/jetbrains-mono/jetbrains-mono-500.woff2"] },
                        { "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "600", "src": ["file:./assets/fonts/jetbrains-mono/jetbrains-mono-600.woff2"] }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "fluid": false,
                    "name": "Small",
                    "size": "0.875rem",
                    "slug": "small"
                },
                {
                    "fluid": false,
                    "name": "Medium",
                    "size": "1rem",
                    "slug": "medium"
                },
                {
                    "fluid": { "min": "1.0625rem", "max": "1.125rem" },
                    "name": "Large",
                    "size": "1.0625rem",
                    "slug": "large"
                },
                {
                    "fluid": { "min": "1.25rem", "max": "1.5rem" },
                    "name": "X-Large",
                    "size": "1.5rem",
                    "slug": "x-large"
                },
                {
                    "fluid": { "min": "1.5rem", "max": "2.25rem" },
                    "name": "2X-Large",
                    "size": "2.25rem",
                    "slug": "xx-large"
                },
                {
                    "fluid": { "min": "2rem", "max": "3rem" },
                    "name": "3X-Large",
                    "size": "3rem",
                    "slug": "xxx-large"
                }
            ]
        },

        "spacing": {
            "customSpacingSize": true,
            "units": ["px", "%", "em", "rem", "vw", "vh"],
            "spacingSizes": [
                { "name": "1", "size": "0.25rem", "slug": "10" },
                { "name": "2", "size": "0.5rem",  "slug": "20" },
                { "name": "3", "size": "0.75rem", "slug": "30" },
                { "name": "4", "size": "1rem",    "slug": "40" },
                { "name": "5", "size": "1.5rem",  "slug": "50" },
                { "name": "6", "size": "2rem",    "slug": "60" },
                { "name": "7", "size": "3rem",    "slug": "70" },
                { "name": "8", "size": "4.5rem",  "slug": "80" },
                { "name": "9", "size": "6rem",    "slug": "90" }
            ]
        },

        "layout": {
            "contentSize": "1000px",
            "wideSize": "1600px"
        },

        "dimensions": {
            "aspectRatios": [
                { "name": "Square",      "ratio": "1",    "slug": "square" },
                { "name": "Standard",    "ratio": "4/3",  "slug": "4-3"    },
                { "name": "Portrait",    "ratio": "3/4",  "slug": "3-4"    },
                { "name": "Classic",     "ratio": "3/2",  "slug": "3-2"    },
                { "name": "Wide",        "ratio": "16/9", "slug": "16-9"   },
                { "name": "Ultra-wide",  "ratio": "21/9", "slug": "21-9"   }
            ],
            "minHeight": true
        },

        "position": {
            "sticky": true
        },

        "shadow": {
            "presets": [
                {
                    "name": "Soft",
                    "shadow": "0 1px 2px rgba(21,50,29,0.10), 0 12px 28px -8px rgba(21,50,29,0.28)",
                    "slug": "natural"
                },
                {
                    "name": "Soft Large",
                    "shadow": "0 2px 4px rgba(21,50,29,0.12), 0 20px 44px -10px rgba(21,50,29,0.34)",
                    "slug": "deep"
                },
                {
                    "name": "Hairline",
                    "shadow": "0 1px 2px rgba(21,50,29,0.08)",
                    "slug": "sharp"
                }
            ]
        },

        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },

        "blocks": {
            "core/navigation": {
                "typography": {
                    "fontSize": true,
                    "lineHeight": true
                }
            },
            "core/post-featured-image": {
                "dimensions": { "aspectRatio": true }
            }
        }
    },

    "styles": {
        "css": ":root{--shadow-sm:0 1px 3px color-mix(in srgb, var(--wp--preset--color--shadow-dark) 16%, transparent);--shadow-md:0 1px 2px color-mix(in srgb, var(--wp--preset--color--shadow-dark) 10%, transparent), 0 14px 30px -10px color-mix(in srgb, var(--wp--preset--color--shadow-dark) 32%, transparent);--shadow-lg:0 2px 4px color-mix(in srgb, var(--wp--preset--color--shadow-dark) 12%, transparent), 0 22px 46px -12px color-mix(in srgb, var(--wp--preset--color--shadow-dark) 38%, transparent);--shadow-inset:inset 0 1px 2px color-mix(in srgb, var(--wp--preset--color--shadow-dark) 20%, transparent);--shadow-inset-sm:inset 0 1px 1px color-mix(in srgb, var(--wp--preset--color--shadow-dark) 16%, transparent);--card-bg:var(--wp--preset--color--surface);--card-radius:1.25rem;--button-bg:var(--wp--preset--color--primary);--button-text:var(--wp--preset--color--base);--button-bg-hover:var(--wp--preset--color--primary-dark);--button-text-hover:var(--wp--preset--color--base);--button-radius:9999px;--button-shadow-active:var(--shadow-sm);--pill-bg:var(--wp--preset--color--primary-light);--pill-text:var(--wp--preset--color--primary-dark);--pill-text-hover:var(--wp--preset--color--primary-dark);--pill-shadow:none;--pill-shadow-active:none;--input-bg:var(--wp--preset--color--base);--input-border:1px solid var(--wp--preset--color--border);--input-shadow:none;--input-radius:0.75rem;}",
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.7"
        },
        "spacing": {
            "padding": {
                "top": "0",
                "bottom": "0",
                "left": "var(--wp--preset--spacing--40)",
                "right": "var(--wp--preset--spacing--40)"
            },
            "blockGap": "var(--wp--preset--spacing--50)"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontWeight": "700",
                    "lineHeight": "1.15",
                    "letterSpacing": "-0.01em"
                }
            },
            "h1": {
                "typography": { "fontSize": "var(--wp--preset--font-size--xxx-large)", "fontWeight": "800" }
            },
            "h2": {
                "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" }
            },
            "h3": {
                "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }
            },
            "h4": {
                "typography": { "fontSize": "var(--wp--preset--font-size--large)" }
            },
            "link": {
                "color": { "text": "var(--wp--preset--color--primary)" },
                ":hover": { "color": { "text": "var(--wp--preset--color--primary-dark)" } },
                "typography": { "textDecoration": "underline" }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--base)"
                },
                "border": { "radius": "9999px" },
                "spacing": {
                    "padding": { "top": "0.625rem", "bottom": "0.625rem", "left": "1.5rem", "right": "1.5rem" }
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--primary-dark)",
                        "text": "var(--wp--preset--color--base)"
                    }
                }
            }
        },
        "blocks": {
            "core/separator": {
                "color": { "text": "var(--wp--preset--color--border)" },
                "border": { "color": "var(--wp--preset--color--border)" }
            },
            "core/pullquote": {
                "border": {
                    "color": "transparent",
                    "style": "none",
                    "width": "0"
                },
                "color": { "text": "var(--wp--preset--color--muted)" },
                "typography": { "fontStyle": "italic" }
            },
            "core/code": {
                "color": { "background": "var(--wp--preset--color--surface)" },
                "border": { "radius": "0.75rem", "color": "var(--wp--preset--color--border)", "width": "1px", "style": "solid" },
                "spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1rem", "right": "1rem" } },
                "typography": { "fontFamily": "var(--wp--preset--font-family--mono)" }
            },
            "core/quote": {
                "border": {
                    "color": "transparent",
                    "style": "none",
                    "width": "0"
                },
                "spacing": { "padding": { "left": "1.25rem" } },
                "typography": { "fontStyle": "italic" }
            },
            "core/post-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontSize": "var(--wp--preset--font-size--xx-large)",
                    "fontWeight": "800"
                }
            },
            "core/post-navigation-link": {
                "color": {
                    "background": "var(--wp--preset--color--surface)",
                    "text": "var(--wp--preset--color--primary)"
                },
                "spacing": {
                    "padding": {
                        "top": "0.5rem",
                        "bottom": "0.5rem",
                        "left": "1.25rem",
                        "right": "1.25rem"
                    }
                },
                "border": {
                    "radius": "9999px"
                }
            },
            "core/comments": {
                "spacing": {
                    "blockGap": "1rem"
                }
            }
        }
    },

    "customTemplates": [
        {
            "name": "page",
            "postTypes": ["page"],
            "title": "Default Page"
        }
    ],

    "templateParts": [
        { "area": "header", "name": "header", "title": "Header" },
        { "area": "footer", "name": "footer", "title": "Footer" }
    ]
}
